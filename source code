    def place_order(self):
        if not self.cart:
            messagebox.showwarning("Empty cart", "Your cart is empty.")
            self.show_cart()
            return
        address = self.address_text.get("1.0", "end").strip() if self.address_text else ""
        if len(address) < 10:
            messagebox.showwarning("Address required", "Please enter a complete delivery address.")
            self.address_text.focus_set()
            return
        for pid, qty in self.cart.items():
            product = self.product_by_id(pid)
            if product is None or qty > product["stock"]:
                messagebox.showerror("Stock changed", "An item is no longer available in that quantity. Please review your cart.")
                self.show_cart()
                return
        total = self.cart_total()
        if not messagebox.askyesno("Confirm order", f"Place your demo order for {money(total)}?"):
            return
        order_id = "NC-" + uuid.uuid4().hex[:8].upper()
        order_date = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        method = self.payment_method.get()
        item_summary = "; ".join(f"{self.product_by_id(pid)['name']} x{qty}" for pid, qty in self.cart.items())
        for pid, qty in self.cart.items():
            self.product_by_id(pid)["stock"] -= qty
        order = {"order_id": order_id, "date": order_date, "customer": self.customer_name,
                 "username": self.current_user, "address": address.replace("\n", ", "),
                 "items": item_summary, "total": f"{total:.2f}", "payment_method": method,
                 "status": ORDER_STATUSES[0]}
        try:
            self.save_products()
            self.save_order(order)
        except OSError as error:
            for pid, qty in self.cart.items():
                self.product_by_id(pid)["stock"] += qty
            try:
                self.save_products()
            except OSError:
                pass
            messagebox.showerror("Could not save order", f"Your order was not confirmed because saving failed.\n{error}")
            return
        self.last_order = {"order_id": order_id, "date": order_date, "total": total,
                           "method": method, "items": item_summary}
        self.cart.clear()
        self.show_success()

