    # ------------------------------------------------------------------ data
    def load_products(self):
        if not os.path.exists(PRODUCT_FILE):
            self.products = [p.copy() for p in PRODUCTS]
            self.save_products()
            return self.products
        try:
            with open(PRODUCT_FILE, "r", newline="", encoding="utf-8") as file:
                rows = list(csv.DictReader(file))
            loaded = [{"id": r["id"], "name": r["name"], "category": r["category"],
                       "price": float(r["price"]), "stock": int(r["stock"]),
                       "emoji": r.get("emoji") or "🛍️"} for r in rows]
            return loaded
        except (OSError, ValueError, KeyError):
            messagebox.showwarning("Product data", "products.csv could not be read. Default products will be used.")
            return [p.copy() for p in PRODUCTS]

    def save_products(self):
        with open(PRODUCT_FILE, "w", newline="", encoding="utf-8") as file:
            writer = csv.DictWriter(file, fieldnames=PRODUCT_FIELDS)
            writer.writeheader()
            writer.writerows(self.products)

    def read_orders(self):
        if not os.path.exists(ORDER_FILE):
            return []
        try:
            with open(ORDER_FILE, "r", newline="", encoding="utf-8") as file:
                return list(csv.DictReader(file))
        except OSError:
            return []

    def write_orders(self, orders):
        with open(ORDER_FILE, "w", newline="", encoding="utf-8") as file:
            writer = csv.DictWriter(file, fieldnames=ORDER_FIELDS, extrasaction="ignore")
            writer.writeheader()
            for row in orders:
                writer.writerow({field: row.get(field, "") for field in ORDER_FIELDS})

    def save_order(self, order):
        orders = self.read_orders()
        orders.append(order)
        self.write_orders(orders)

    def load_users(self):
        if not os.path.exists(USER_FILE):
            return {}
        try:
            with open(USER_FILE, "r", newline="", encoding="utf-8") as file:
                return {r["username"]: r for r in csv.DictReader(file)}
        except (OSError, KeyError):
            return {}

    def save_user(self, username, full_name, password):
        salt = os.urandom(16).hex()
        row = {"username": username, "full_name": full_name, "salt": salt,
               "password_hash": hash_password(password, salt)}
        new_file = not os.path.exists(USER_FILE)
        with open(USER_FILE, "a", newline="", encoding="utf-8") as file:
            writer = csv.DictWriter(file, fieldnames=USER_FIELDS)
            if new_file:
                writer.writeheader()
            writer.writerow(row)

    def product_by_id(self, pid):
        return next((p for p in self.products if p["id"] == pid), None)

    def categories(self):
        return sorted({p["category"] for p in self.products})

