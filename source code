    def attach_order_detail(self, tree, orders, parent):
        """Show address + full items for the selected order under the table."""
        by_id = {o.get("order_id", ""): o for o in orders}
        detail = tk.StringVar(value="Select an order to see its delivery address and items.")
        box = self.panel(parent, padx=16, pady=10)
        box.pack(fill="x", pady=(10, 0))
        self.label(box, "", FONT, MUTED, bg=CARD, textvariable=detail, wraplength=980,
                   justify="left", anchor="w").pack(fill="x")

        def on_select(_event):
            selected = tree.selection()
            if selected and selected[0] in by_id:
                o = by_id[selected[0]]
                detail.set(f"Items: {o.get('items', '')}\nDeliver to: {o.get('address', '') or '—'}")

        tree.bind("<<TreeviewSelect>>", on_select)

