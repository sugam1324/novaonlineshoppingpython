    def start_session(self, username, display_name, admin=False):
        self.current_user = username
        self.customer_name = display_name
        self.is_admin = admin
        self.cart = {}
        self.search_text.set("")
        self.category.set("All")
        if admin:
            self.show_admin_products()
        else:
            self.show_shop()

    def handle_register(self):
        full_name = self.name_entry.get().strip()
        username = self.user_entry.get().strip().lower()
        password = self.pass_entry.get()
        confirm = self.confirm_entry.get()
        if not full_name:
            messagebox.showwarning("Name required", "Please enter your full name.")
            return
        if not re.fullmatch(r"[a-z0-9_.]{3,20}", username):
            messagebox.showwarning("Invalid username",
                                   "Username must be 3-20 characters: letters, numbers, dot or underscore.")
            return
        if safe_equal(username, ADMIN_USERNAME.lower()) or username in self.load_users():
            messagebox.showwarning("Username taken", "That username is already in use. Try another one.")
            return
        if len(password) < 6:
            messagebox.showwarning("Weak password", "Password must be at least 6 characters.")
            return
        if password != confirm:
            messagebox.showwarning("Mismatch", "Passwords do not match.")
            return
        try:
            self.save_user(username, full_name, password)
        except OSError as error:
            messagebox.showerror("Could not create account", str(error))
            return
        messagebox.showinfo("Account created", "Your account is ready. Please sign in.")
        self.show_login("login")

    def handle_login(self):
        username = self.user_entry.get().strip().lower()
        password = self.pass_entry.get()
        if not username or not password:
            messagebox.showwarning("Missing details", "Enter your username and password.")
            return
        user = self.load_users().get(username)
        if not user or not safe_equal(hash_password(password, user["salt"]), user["password_hash"]):
            messagebox.showerror("Login failed", "Incorrect username or password.")
            self.pass_entry.delete(0, "end")
            return
        self.start_session(username, user["full_name"])

    def handle_admin_login(self):
        username = self.user_entry.get().strip()
        password = self.pass_entry.get()
        if safe_equal(username, ADMIN_USERNAME) and safe_equal(password, ADMIN_PASSWORD):
            self.start_session(ADMIN_USERNAME, "Admin", admin=True)
        else:
            messagebox.showerror("Login failed", "Incorrect admin ID or password.")
            self.pass_entry.delete(0, "end")

    def logout(self):
        if self.cart and not self.is_admin:
            if not messagebox.askyesno("Logout", "Your cart will be cleared. Log out anyway?"):
                return
        self.current_user = None
        self.customer_name = ""
        self.is_admin = False
        self.cart = {}
        self.show_login()

    # ------------------------------------------------------------------ shop
    def show_shop(self):
        self.clear_screen()
        self.topbar()
        content = self.content_area()
        self.heading(content, f"Welcome, {self.customer_name}  ✨", "Find something you'll love. Browse the collection below.")
        search_row = tk.Frame(content, bg=BG)
        search_row.pack(fill="x", pady=(0, 12))
        search = self.dark_entry(search_row, self.search_text)
        search.pack(side="left", fill="x", expand=True, ipady=11, padx=(0, 12))
        search.bind("<KeyRelease>", lambda event: self.render_products())
        chooser = ttk.Combobox(search_row, textvariable=self.category,
                               values=["All"] + self.categories(), state="readonly", width=18)
        chooser.pack(side="right", ipady=5)
        chooser.bind("<<ComboboxSelected>>", lambda event: self.render_products())
        self.product_area = tk.Frame(content, bg=BG)
        self.product_area.pack(fill="both", expand=True)
        self.render_products()
        self.label(content, "🔒 Demo checkout    ·    📦 Orders saved on this computer    ·    Made with Python",
                   SMALL, MUTED, bg=BG).pack(pady=(14, 2))

    def render_products(self):
        if not hasattr(self, "product_area"):
            return
        for widget in self.product_area.winfo_children():
            widget.destroy()
        query = self.search_text.get().strip().lower()
        category = self.category.get()
        matches = [p for p in self.products if query in p["name"].lower()
                   and (category == "All" or p["category"] == category)]
        if not matches:
            self.label(self.product_area, "No products found. Try a different search.", SUBHEADING, MUTED, bg=BG).pack(pady=50)
            return
        for index, product in enumerate(matches):
            row, col = divmod(index, 4)
            card = self.panel(self.product_area, padx=12, pady=12)
            card.grid(row=row, column=col, padx=6, pady=7, sticky="nsew")
            self.product_area.grid_columnconfigure(col, weight=1, uniform="product")
            art = tk.Frame(card, bg=ENTRY_BG, height=88)
            art.pack(fill="x", pady=(0, 10))
            art.pack_propagate(False)
            self.label(art, product["emoji"], ("Segoe UI Emoji", 34), TEXT, bg=ENTRY_BG).pack(expand=True)
            self.label(card, product["name"], ("Segoe UI", 11, "bold"), TEXT, bg=CARD).pack(anchor="w")
            self.label(card, product["category"], SMALL, MUTED, bg=CARD).pack(anchor="w", pady=(2, 6))
            self.label(card, money(product["price"]), ("Segoe UI", 13, "bold"), ACCENT, bg=CARD).pack(anchor="w")
            stocked = product["stock"] > 0
            self.label(card, f"●  {product['stock']} in stock" if stocked else "Out of stock",
                       SMALL, TEAL if stocked else RED, bg=CARD).pack(anchor="w", pady=(5, 9))
            self.button(card, "+  Add to cart", lambda p=product: self.add_to_cart(p["id"]),
                        stocked, True).pack(fill="x")

    def add_to_cart(self, product_id):
        product = self.product_by_id(product_id)
        if not product or product["stock"] <= 0:
            messagebox.showwarning("Unavailable", "This product is out of stock.")
            return
        if self.cart.get(product_id, 0) >= product["stock"]:
            messagebox.showwarning("Stock limit", "You have reached the available stock limit.")
            return
        self.cart[product_id] = self.cart.get(product_id, 0) + 1
        self.show_shop()

    # ------------------------------------------------------------------ cart
    def cart_total(self):
        return sum(self.product_by_id(pid)["price"] * qty for pid, qty in self.cart.items())

    def prune_cart(self):
        """Drop items an admin may have deleted or whose stock has dropped."""
        for pid in list(self.cart):
            product = self.product_by_id(pid)
            if product is None or product["stock"] <= 0:
                del self.cart[pid]
            elif self.cart[pid] > product["stock"]:
                self.cart[pid] = product["stock"]

    def show_cart(self):
        self.prune_cart()
        self.clear_screen()
        self.topbar()
        content = self.content_area()
        self.heading(content, "Your shopping cart", "Review your picks before moving to delivery details.")
        if not self.cart:
            card = self.panel(content, padx=28, pady=30)
            card.pack(fill="x", pady=10)
            self.label(card, "Your cart is waiting for something great.", SUBHEADING, MUTED, bg=CARD).pack(anchor="w")
            self.button(card, "←  Browse products", self.show_shop).pack(anchor="w", pady=(18, 0))
            return
        table = self.panel(content, padx=12, pady=12)
        table.pack(fill="both", expand=True)
        headers = {"name": ("Product", 250), "category": ("Category", 170), "price": ("Unit price", 150),
                   "quantity": ("Qty", 100), "subtotal": ("Subtotal", 170)}
        tree = self.make_tree(table, headers, selectmode="browse")
        for pid, qty in self.cart.items():
            p = self.product_by_id(pid)
            tree.insert("", "end", iid=pid, values=(f"{p['emoji']}  {p['name']}", p["category"],
                        money(p["price"]), qty, money(p["price"] * qty)))
        controls = tk.Frame(content, bg=BG)
        controls.pack(fill="x", pady=12)
        self.button(controls, "+ Increase", lambda: self.change_quantity(tree, 1), False, True).pack(side="left", padx=(0, 7))
        self.button(controls, "− Decrease", lambda: self.change_quantity(tree, -1), False, True).pack(side="left", padx=7)
        self.button(controls, "Remove", lambda: self.remove_item(tree), False, True).pack(side="left", padx=7)
        bottom = self.panel(content, padx=16, pady=12)
        bottom.pack(fill="x", pady=4)
        self.label(bottom, f"Order total   {money(self.cart_total())}", ("Segoe UI", 16, "bold"), ACCENT, bg=CARD).pack(side="left")
        self.button(bottom, "Delivery & payment  →", self.show_payment).pack(side="right")

    def change_quantity(self, tree, change):
        selected = tree.selection()
        if not selected:
            messagebox.showwarning("Select item", "Select a product first.")
            return
        pid = selected[0]
        product = self.product_by_id(pid)
        quantity = self.cart[pid] + change
        if quantity <= 0:
            del self.cart[pid]
        elif quantity > product["stock"]:
            messagebox.showwarning("Stock limit", "Not enough stock available.")
            return
        else:
            self.cart[pid] = quantity
        self.show_cart()

    def remove_item(self, tree):
        selected = tree.selection()
        if not selected:
            messagebox.showwarning("Select item", "Select a product first.")
            return
        self.cart.pop(selected[0], None)
        self.show_cart()

    # ------------------------------------------------------ address & payment
    def show_payment(self):
