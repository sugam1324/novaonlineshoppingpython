    def admin_set_status(self, tree, status):
        selected = tree.selection()
        if not selected:
            messagebox.showwarning("Select an order", "Select an order first.")
            return
        orders = self.read_orders()
        for order in orders:
            if order.get("order_id") == selected[0]:
                order["status"] = status
        try:
            self.write_orders(orders)
        except OSError as error:
            messagebox.showerror("Could not update", str(error))
            return
        self.show_admin_orders()


