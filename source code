    def admin_selected_product(self, tree):
        selected = tree.selection()
        if not selected:
            messagebox.showwarning("Select a product", "Select a product from the table first.")
            return None
        return self.product_by_id(selected[0])

    def admin_save_products(self):
        try:
            self.save_products()
            return True
        except OSError as error:
            messagebox.showerror("Could not save", f"products.csv could not be written.\n{error}")
            return False

    def next_product_id(self):
        numbers = [int(p["id"][1:]) for p in self.products if re.fullmatch(r"P\d+", p["id"])]
        return "P{:03d}".format(max(numbers, default=0) + 1)

    def admin_add_product(self):
        win = tk.Toplevel(self)
        win.title("Add product")
        win.configure(bg=CARD)
        win.transient(self)
        win.resizable(False, False)
        win.geometry(f"+{self.winfo_rootx() + 330}+{self.winfo_rooty() + 120}")
        body = tk.Frame(win, bg=CARD, padx=28, pady=24)
        body.pack()
        self.label(body, "Add a new product", SUBHEADING, TEXT, bg=CARD).pack(anchor="w", pady=(0, 14))

        def row(text):
            self.label(body, text, ("Segoe UI", 10, "bold"), TEXT, bg=CARD).pack(anchor="w", pady=(0, 5))

        row("Product name")
        name_entry = self.dark_entry(body, width=36)
        name_entry.pack(fill="x", ipady=8, pady=(0, 10))
        row("Category (pick or type a new one)")
        cat_var = tk.StringVar()
        ttk.Combobox(body, textvariable=cat_var, values=self.categories(), width=34).pack(fill="x", ipady=4, pady=(0, 10))
        row("Price (₹)")
        price_entry = self.dark_entry(body, width=36)
        price_entry.pack(fill="x", ipady=8, pady=(0, 10))
        row("Opening stock")
        stock_entry = self.dark_entry(body, width=36)
        stock_entry.insert(0, "10")
        stock_entry.pack(fill="x", ipady=8, pady=(0, 10))
        row("Emoji icon (optional)")
        emoji_entry = self.dark_entry(body, width=36)
        emoji_entry.pack(fill="x", ipady=8, pady=(0, 16))

        def save():
            name = name_entry.get().strip()
            category = cat_var.get().strip()
            if not name or not category:
                messagebox.showwarning("Missing details", "Name and category are required.", parent=win)
                return
            if any(p["name"].lower() == name.lower() for p in self.products):
                messagebox.showwarning("Duplicate", "A product with this name already exists.", parent=win)
                return
            try:
                price = float(price_entry.get().strip())
                stock = int(stock_entry.get().strip())
                if price <= 0 or stock < 0:
                    raise ValueError
            except ValueError:
                messagebox.showwarning("Invalid number", "Price must be above 0 and stock must be 0 or more.", parent=win)
                return
            product = {"id": self.next_product_id(), "name": name, "category": category,
                       "price": price, "stock": stock, "emoji": emoji_entry.get().strip() or "🛍️"}
            self.products.append(product)
            if not self.admin_save_products():
                self.products.remove(product)
                return
            win.destroy()
            self.show_admin_products()

        buttons = tk.Frame(body, bg=CARD)
        buttons.pack(fill="x")
        self.button(buttons, "Cancel", win.destroy, False, True).pack(side="left")
        self.button(buttons, "Add product", save, True, True).pack(side="right")
        name_entry.focus_set()
        win.bind("<Return>", lambda event: save())
        win.grab_set()

    def admin_add_stock(self, tree):
        product = self.admin_selected_product(tree)
        if not product:
            return
        amount = simpledialog.askinteger("Add stock", f"Units to add to {product['name']}\n(current stock: {product['stock']})",
                                         parent=self, minvalue=1, maxvalue=100000)
        if amount is None:
            return
        product["stock"] += amount
        if self.admin_save_products():
            self.show_admin_products()
        else:
            product["stock"] -= amount

    def admin_edit_price(self, tree):
        product = self.admin_selected_product(tree)
        if not product:
            return
        price = simpledialog.askfloat("Edit price", f"New price for {product['name']} (₹)",
                                      parent=self, initialvalue=product["price"], minvalue=0.01)
        if price is None:
            return
        old = product["price"]
        product["price"] = price
        if self.admin_save_products():
            self.show_admin_products()
        else:
            product["price"] = old

    def admin_delete_product(self, tree):
        product = self.admin_selected_product(tree)
        if not product:
            return
        if not messagebox.askyesno("Delete product",
                                   f"Delete '{product['name']}' permanently?\nPast orders will keep their record."):
            return
        index = self.products.index(product)
        self.products.remove(product)
        if self.admin_save_products():
            self.show_admin_products()
        else:
            self.products.insert(index, product)

